# 环境标识
ENV = 'production'

# 标签
NODE_ENV = demo

# 接口地址：留空表示前端走同源相对路径 /exam...
# 两种部署都适用：
#   1) 前端 dist 放到后端 static 目录（同源）
#   2) 前后端解耦：Nginx 托管 dist 并把 /exam /common /upload 反代到后端
#      （见 docs/ops/deployment-frontend-nginx.md）
# 仅当前端与后端不同源且不经 Nginx 反代时，才填后端绝对地址（需后端 CORS 放行）。
VUE_APP_BASE_API = ''

